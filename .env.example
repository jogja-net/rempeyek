# .env.example — contoh variabel lingkungan. Salin ke .env.local untuk pengembangan.
# Di Vercel, set variabel yang sama di Project Settings → Environment Variables.

# Nomor WhatsApp bisnis, format 62xxxxxxxxxx tanpa tanda +, spasi, atau tanda hubung.
# Dipakai sebagai satu-satunya pintu masuk pesanan. Wajib diisi untuk build produksi.
NEXT_PUBLIC_WA_NUMBER=

# URL publik situs, tanpa garis miring di akhir.
# Preview: biarkan kosong (default http://localhost:3000).
# Produksi: isi dengan domain final, mis. https://rempeyekbuaviella.com
NEXT_PUBLIC_SITE_URL=
